# =============================================================================
#  es-snapshot-restore - configuration file
#
#  Copy to config.env and adjust:   cp config.env.example config.env
#                                   chmod 600 config.env
#
#  This file is sourced as a bash script (VAR="value" format).
#  Passwords: leave empty to be prompted at runtime (recommended), or export
#  the environment variable before running (e.g. export SOURCE_ES_PASS=...).
# =============================================================================

# -----------------------------------------------------------------------------
# SOURCE cluster (old / PRODUCTION) - where the snapshots are (or will be created)
# -----------------------------------------------------------------------------
SOURCE_ES_URL="https://es-old.example.com"         # URL exposed by the nginx ingress (may include a path, e.g. https://host/es)
SOURCE_ES_USER="elastic"
SOURCE_ES_PASS="${SOURCE_ES_PASS:-}"                # empty = prompt at runtime
SOURCE_CA_CERT=""                                   # path to a CA (PEM) if the certificate is not publicly trusted
SOURCE_INSECURE_TLS="false"                         # true = skip TLS certificate validation (curl -k)

# -----------------------------------------------------------------------------
# DESTINATION cluster (new) - where the restore will be done
# -----------------------------------------------------------------------------
DEST_ES_URL="https://es-new.example.com"
DEST_ES_USER="elastic"
DEST_ES_PASS="${DEST_ES_PASS:-}"
DEST_CA_CERT=""
DEST_INSECURE_TLS="false"

# -----------------------------------------------------------------------------
# Repositories
# -----------------------------------------------------------------------------
# Name of the snapshot repository ON THE SOURCE CLUSTER (the one curator uses).
# Used to create new snapshots.
SOURCE_REPO="backup-old"

# Name of the repository registered ON THE DESTINATION CLUSTER that points to the
# source container in READ-ONLY mode. The destination lists and restores snapshots
# through it, so the restore never touches the production cluster.
DEST_RO_REPO_FOR_SOURCE="backup-old-readonly"

# ---- Only used by the "Register read-only repository" option ----
# Settings (type, container, base_path, compress, chunk_size...) are copied
# automatically from the original repository; here you only override:
DEST_RO_REPO_CLIENT=""                          # azure client in the DESTINATION keystore (azure.client.<name>.*). Empty = same name as on source
DEST_RO_REPO_MAX_RESTORE_BYTES_PER_SEC="200mb"  # restore read throttle PER NODE (ES 6.x default = 40mb). Empty = keep source value

# Optional: register the DESTINATION repo as read-only on the SOURCE (reverse direction).
# This writes repository metadata to the production cluster (lightweight). Leave empty if unused.
DEST_REPO=""                                # name of the destination's own snapshot repository
SOURCE_RO_REPO_FOR_DEST=""                  # name it will have on the source
SOURCE_RO_REPO_CLIENT=""                    # azure client in the SOURCE keystore. Empty = same name as on destination

# -----------------------------------------------------------------------------
# Snapshot (when choosing "create a new snapshot")
# -----------------------------------------------------------------------------
SNAPSHOT_NAME_PREFIX="migration"  # final name: <prefix>-YYYY.MM.DD-HHMMSS (lowercase)
                                  # IMPORTANT: use a prefix that curator's "delete_snapshots" will NOT delete
SNAPSHOT_INDICES="*,-.*"          # indices included in the new snapshot
SNAPSHOT_POLL_INTERVAL=30         # seconds between progress checks

# Listing existing snapshots:
#   dest   = list through the DESTINATION read-only repo (no load on production) [recommended]
#   source = list through the SOURCE cluster repo
LIST_SNAPSHOTS_FROM="dest"
SNAPSHOT_LIST_LIMIT=30            # show the N most recent
ALLOW_PARTIAL_SNAPSHOTS="false"   # true = allow choosing PARTIAL snapshots (indices with failed shards are excluded from the restore)

# -----------------------------------------------------------------------------
# Restore
# -----------------------------------------------------------------------------
RESTORE_INDICES="*,-.*"           # index pattern to restore (the default excludes system indices, which start with ".")
RESTORE_INCLUDE_ALIASES="true"    # also restore index aliases

# Index settings that will NOT be restored (comma-separated). Useful if the source has
# settings that don't apply on the destination (e.g. node-attribute allocation, ILM policy):
#   RESTORE_IGNORE_INDEX_SETTINGS="index.routing.allocation.require.box_type,index.lifecycle.name"
# number_of_shards/number_of_replicas are NOT allowed here: the restore keeps the snapshot values.
RESTORE_IGNORE_INDEX_SETTINGS=""

# What to do if a snapshot index already exists on the destination:
#   ask    = ask at runtime (default)
#   abort  = cancel the restore
#   skip   = restore only the indices that don't exist on the destination
#   delete = DELETE the conflicting indices on the destination and restore them (asks for extra confirmation)
ON_CONFLICT="ask"

RESTORE_POLL_INTERVAL=30          # seconds between restore progress checks
CHECK_DISK_BEFORE_RESTORE="true"  # estimate size/shards and compare with destination free disk
DISK_WATERMARK_PERCENT=85         # disk usage % considered the limit in the estimate

# Expected values (your index standard). Used in the estimate and when verifying
# indices that no longer exist on the source.
EXPECTED_PRIMARY_SHARDS=3
EXPECTED_REPLICAS=1

# Post-restore verification compares pri/rep/docs with the source (_cat/indices: light read).
# false = no calls to the source during verification.
VERIFY_COMPARE_WITH_SOURCE="true"

# -----------------------------------------------------------------------------
# Temporary performance tuning ON THE DESTINATION during the restore (transient settings).
# Reverted automatically at the end (or via the "Revert tuning" option).
# Does not affect the source. Empty = leave that setting unchanged.
# -----------------------------------------------------------------------------
DEST_TUNE_DURING_RESTORE="false"
DEST_TUNE_RECOVERY_MAX_BYTES_PER_SEC="200mb"        # indices.recovery.max_bytes_per_sec (replica creation)
DEST_TUNE_NODE_INITIAL_PRIMARIES_RECOVERIES="8"     # primaries restored in parallel per node (default 4)
DEST_TUNE_NODE_CONCURRENT_RECOVERIES="4"            # replicas recovered in parallel per node (default 2)

# -----------------------------------------------------------------------------
# Misc
# -----------------------------------------------------------------------------
CURL_CONNECT_TIMEOUT=10       # seconds
CURL_MAX_TIME=120             # max time for regular requests
CURL_LONG_MAX_TIME=600        # heavy requests (snapshot listing/size). The ingress also has a timeout (proxy-read-timeout)
LOG_DIR="./logs"              # relative to the script directory
STATE_DIR="./state"
